{
  "name": "server-expiry-reminder",
  "version": "0.1.4",
  "private": true,
  "description": "Single-user server expiry reminder system",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev --workspace apps/backend\" \"npm run dev --workspace apps/frontend\"",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:frontend": "npm run dev --workspace apps/frontend",
    "db:migrate": "npm run migrate --workspace apps/backend",
    "db:backup": "npm run backup --workspace apps/backend",
    "admin:create": "npm run admin:create --workspace apps/backend",
    "admin:recovery:create": "npm run admin:recovery:create --workspace apps/backend",
    "build": "npm run build --workspace apps/frontend && npm run build --workspace apps/backend",
    "start": "npm run start --workspace apps/backend",
    "start:prod": "node apps/backend/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
