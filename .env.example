# Backend listener settings
PORT=3000
HOST=127.0.0.1

# Frontend origin allowed by the backend during development
CORS_ORIGIN=http://localhost:5173

# SQLite database file. The parent directory is created automatically.
DATABASE_PATH=./data/server-expiry-reminder.sqlite
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Authentication settings
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# Set these only while running npm run admin:create, then remove them.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password

# Reminder scheduler defaults. Telegram transport is wired in phase 6.
REMINDER_CRON=* * * * *
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BASE_SECONDS=300
REMINDER_RETRY_MAX_SECONDS=86400
REMINDER_PROCESSING_TIMEOUT_SECONDS=600
REMINDER_SCHEDULER_ENABLED=false
REMINDER_BATCH_SIZE=10

# Telegram settings. Keep these out of source control.
# TELEGRAM_BOT_TOKEN=123456:replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-chat-id
# TELEGRAM_API_BASE_URL=https://api.telegram.org
