[Unit]
Description=Server Expiry Reminder API
After=network.target

[Service]
Type=simple
User=server-reminder
Group=server-reminder
WorkingDirectory=/opt/server-expiry-reminder
EnvironmentFile=/opt/server-expiry-reminder/apps/backend/.env
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/node /opt/server-expiry-reminder/apps/backend/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/server-expiry-reminder/apps/backend/data /opt/server-expiry-reminder/apps/backend/backups

[Install]
WantedBy=multi-user.target
